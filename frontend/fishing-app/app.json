{
  "expo": {
    "name": "AquaWatch",
    "slug": "AquaWatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "src/assets/AppLogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "ios": {
  "supportsTablet": true,
  "infoPlist": {
    "NSPhotoLibraryAddUsageDescription": "AquaWatch saves your trip QR codes to your photo gallery."
    
  }
},

    "android": {
  "adaptiveIcon": {
    "foregroundImage": "src/assets/icon.png",
    "backgroundColor": "#004675"
  },
  "permissions": [
    "READ_MEDIA_IMAGES",
    "ACCESS_FINE_LOCATION"
  ],
  "edgeToEdgeEnabled": true,
  "package": "com.anonymous.AquaWatch"
},

    "web": {
      "favicon": "src/assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AquaWatch to use your location."
        }
      ]
    ]
  }
}
